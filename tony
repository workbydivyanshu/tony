#!/usr/bin/env python3
"""tony — free-model-native agent CLI. v0.1: catalog + tiers + --models/--status.

Stdlib only. Never talks raw HTTP to model gateways (P3+ rides `opencode run`).
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from lib import boulder, catalog, config, doctor, mcp, memory as mem_mod, roles, score as score_mod, tiers, watch  # noqa: E402

VERSION = "0.4.0-p24"
TONY_DIR = os.path.join(os.path.expanduser("~"), ".tony")
TONY_DIR_ROOT = os.path.dirname(os.path.abspath(__file__))


def cmd_score(b: dict, gate: str, evidence: float | None = None) -> int:
    """Centralized score computation via score.compute. Returns int score."""
    return score_mod.compute(b, gate, evidence)["score"]


def open_boulders() -> list:
    out = []
    for d in (os.path.join(TONY_DIR, "boulders"), os.path.expanduser("~/.fleet/boulder")):
        try:
            out += [os.path.join(d, f) for f in sorted(os.listdir(d)) if f.endswith(".md")]
        except OSError:
            pass
    return out


def cmd_models(_args) -> int:
    models = catalog.live_catalog()
    raw = tiers.assign_roles_with_sources(models, config.get_roles() or None)
    print(f"tony {VERSION} — live opencode catalog ({len(models)} models):")
    for m in models:
        print(f"  {m}")
    print("\nrole assignments:")
    for role, val in raw.items():
        if isinstance(val, dict):
            mark = " [override]" if val["source"] == "override" else ""
            print(f"  {role:12s} -> {val['model']}{mark}")
        else:
            print(f"  {role:12s} -> {val}")
    return 0


def cmd_set_role(spec: str) -> int:
    """--set-role ROLE=PATTERN: validate first, write only on success."""
    if "=" not in spec:
        print("tony: --set-role needs ROLE=PATTERN", file=sys.stderr)
        return 2
    role, pattern = spec.split("=", 1)
    try:
        config.set_role(role, pattern)
    except (KeyError, re.error) as e:
        print(f"tony: --set-role: {e}", file=sys.stderr)
        return 2
    print(f"tony: role '{role}' -> pattern '{pattern}'")
    return 0


def cmd_clear_role(role: str) -> int:
    config.clear_role(role)
    print(f"tony: role '{role}' override cleared")
    return 0


def cmd_show_config(_args) -> int:
    models = catalog.live_catalog()
    for w in config.validate(models):
        print(f"tony: warning: {w}", file=sys.stderr)
    raw = tiers.assign_roles_with_sources(models, config.get_roles() or None)
    for role, val in raw.items():
        if isinstance(val, dict):
            print(f"  {role:12s} -> {val['model']} ({val['source']})")
        else:
            print(f"  {role:12s} -> {val} (tier-default)")
    return 0


def cmd_auto_config(_args) -> int:
    config.clear_roles()
    print("tony: overrides cleared; reseated from live catalog")
    return cmd_show_config(_args)


def cmd_status(_args) -> int:
    models = catalog.live_catalog()
    tmap = tiers.tier_map(models)
    roles = tiers.assign_roles(models)
    print(json.dumps({
        "tony": VERSION,
        "catalog": models,
        "tiers": tmap,
        "roles": roles,
        "mcp": mcp.names(),
        "boulders": open_boulders(),
    }, indent=2))
    return 0


def cmd_mcp_status(_args) -> int:
    servers = mcp.live_servers()
    if not servers:
        print("tony: no MCP servers reachable (`opencode mcp list` empty/failed)")
        return 1
    print(f"tony {VERSION} — MCP servers via opencode ({len(servers)}):")
    for s in servers:
        mark = "connected" if s["connected"] else "UNREACHABLE"
        print(f"  {s['name']:12s} {mark}")
    return 0


def cmd_doctor() -> int:
    results = doctor.run_all()
    counts = {"ok": 0, "warn": 0, "fail": 0, "skip": 0}
    for name, status, detail in results:
        counts[status] += 1
        print(f"DOCTOR {status} {name}: {detail}")
    summary = "HEALTHY" if counts["fail"] == 0 else "SICK"
    print(f"DOCTOR SUMMARY: {summary} ({counts['ok']} ok, "
          f"{counts['warn']} warn, {counts['fail']} fail, "
          f"{counts['skip']} skip)")
    return 0 if counts["fail"] == 0 else 1


def cmd_remember(fact: str) -> int:
    try:
        p = mem_mod.remember(fact)
    except ValueError as e:
        print(f"tony: --remember: {e}", file=sys.stderr)
        return 2
    print(f"tony: remembered -> {p}")
    return 0


def cmd_recall(query) -> int:
    lines = mem_mod.recall(query if query else None)
    if not lines:
        print("tony: memory empty" + (f" (no match for {query!r})" if query else ""))
        return 0
    for ln in lines:
        print(ln)
    return 0


def cmd_forget(substr: str) -> int:
    n = mem_mod.forget(substr)
    print(f"tony: forgot {n} line(s) matching {substr!r}")
    return 0


def cmd_memory(_args) -> int:
    p = mem_mod.mem_path()
    print(f"tony: memory file: {p}")
    return cmd_recall(None)


def cmd_chat(session, timeout: int = 600) -> int:
    """Conversational loop: fresh memory injected per turn, one fast-tier call each."""
    from lib import chat as chat_mod
    from lib import engine as eng
    name = chat_mod.slugify_session(session or "default")
    models = catalog.live_catalog()
    assignments = tiers.assign_roles(models)
    model = assignments.get("scribe") or assignments.get("explorer")
    if not model:
        print("tony: no fast-tier model available for chat", file=sys.stderr)
        return 1
    workdir = os.path.join(os.path.expanduser("~"), ".tony", "work", "chat-" + name)
    print(f"tony chat [{name}] on {model} — /quit to exit")

    def _live(prompt: str) -> str:
        res = eng.role_call("scribe", model, prompt, workdir, timeout=timeout)
        return eng.sanitize(res["output"]).strip() or "(empty reply)"

    def _build(msg: str, hist: list) -> str:
        from lib import skills as skills_mod
        return chat_mod.build_prompt(msg, hist,
                                     memory_lines=mem_mod.recall(limit=20),
                                     mcp_servers=mcp.names(),
                                     matched_skills=skills_mod.match(msg, skills_mod.discover()))

    chat_mod.repl(name, input_fn=lambda p: input(p), output_fn=print,
                  call_fn=_live, prompt_builder=_build)
    return 0


def slugify(mission: str) -> str:
    import re
    slug = re.sub(r"[^a-z0-9]+", "-", mission.lower()).strip("-")[:48]
    return slug or "mission"


def cmd_dryrun(mission: str) -> int:
    """Plan only: write a placeholder boulder, execute nothing."""
    slug = slugify(mission)
    b = boulder.new(slug)
    boulder.log(b, f"dry-run plan for: {mission[:120]}")
    boulder.add_todo(b, "1. <architect fills this in during P3 — dry-run writes structure only>")
    boulder.add_wave(b, "F1. <verification command from architect>")
    p = boulder.save(slug, b)
    print(f"dry-run boulder: {p}")
    print("NOTE: execution happens in P3 (opencode run role calls). Nothing was executed.")
    return 0


def _matched_skills(mission: str) -> list:
    from lib import skills as skills_mod
    return skills_mod.match(mission, skills_mod.discover())


def cmd_research(topic: str, timeout: int = 900) -> int:
    """Deep-research fan-out: 3 parallel explorers (websearch MCP) -> researcher
    synthesis -> critic gate -> wave (report exists, >=3 cited URLs)."""
    from concurrent.futures import ThreadPoolExecutor
    from lib import engine as eng, research as res_mod, report as rep, score as score_mod
    models = catalog.live_catalog()
    raw = tiers.assign_roles_with_sources(models, config.get_roles() or None)
    assignments = {r: (v["model"] if isinstance(v, dict) else v) for r, v in raw.items()}
    slug = slugify(f"research {topic}")[:48]
    workdir = os.path.join(os.path.expanduser("~"), ".tony", "work", slug)
    print(f"tony: research '{topic[:80]}' -> slug {slug}")

    prompts = res_mod.explorer_prompts(topic)
    print(f"tony: fan-out {len(prompts)} explorers (parallel, websearch MCP)")
    with ThreadPoolExecutor(max_workers=len(prompts)) as pool:
        futures = [pool.submit(eng.role_call, "explorer",
                               assignments["explorer"], p, workdir, timeout=timeout)
                   for p in prompts]
        results = [f.result() for f in futures]
    findings = [eng.sanitize(r["output"]) for r in results if r["status"] == "ok"]
    ok_n = len(findings)
    print(f"tony: explorers ok {ok_n}/{len(prompts)}")
    if not findings:
        print("tony: all explorers failed; nothing to synthesize")
        return 1

    syn = eng.role_call("researcher", assignments["researcher"],
                        res_mod.synthesis_prompt(topic, findings), workdir,
                        timeout=timeout)
    print(f"tony: synthesis {syn['status']} ({syn['duration']:.0f}s) -> {syn['outfile']}")
    if syn["status"] != "ok":
        print("tony: synthesis failed")
        return 1
    report_path = os.path.join(workdir, "brief.md")
    with open(report_path, "w") as f:
        f.write(eng.sanitize(syn["output"]))

    b = boulder.new(f"research: {topic[:60]}")
    boulder.add_todo(b, "fan-out explorers via websearch MCP")
    boulder.add_todo(b, "synthesized cited brief")
    boulder.log(b, f"explorers ok {ok_n}/{len(prompts)}; brief -> {report_path}")
    boulder.save(slug, b)  # critic must find a real boulder on disk (P15 find)

    # P19a: persist the explorer corpus so the citation wave verifies
    # membership (report URLs ⊆ explorer URLs), not URL-shape counting.
    sources_path = os.path.join(workdir, "explorers.md")
    with open(sources_path, "w") as f:
        f.write("\n\n".join(findings) + "\n")

    crit = eng.role_call("critic", assignments["critic"],
                         roles.critic_prompt(
                             f"BOULDER: ~/.tony/boulders/{slug}.md\n"
                             f"BRIEF UNDER REVIEW: {report_path}\n\n"
                             + open(report_path).read()), workdir,
                         timeout=timeout)
    gate = "PASS"
    from lib import critic_verdict as cv
    if crit["status"] != "ok" or cv.is_issues(eng.sanitize(crit["output"])):
        gate = "ISSUES"
        fix = eng.role_call("researcher", assignments["researcher"],
                            "The critic flagged issues in the brief at "
                            f"{report_path}. Rewrite the brief fixing them: "
                            + eng.sanitize(crit["output"])[:1500], workdir,
                            timeout=timeout)
        if fix["status"] == "ok":
            with open(report_path, "w") as f:
                f.write(eng.sanitize(fix["output"]))
            gate = "PASS-after-fix"
    print(f"tony: critic gate {gate}")

    results_wave = [subprocess.run(c, shell=True, capture_output=True).returncode == 0
                    for c in res_mod.wave_cmds(report_path, sources_path)]
    b["todos"][0]["box"] = ok_n > 0
    b["todos"][1]["box"] = syn["status"] == "ok"
    boulder.add_wave(b, "report exists")
    b["wave"][0]["box"] = results_wave[0]
    boulder.add_wave(b, "citations verified from explorer corpus")
    b["wave"][1]["box"] = results_wave[1]
    boulder.log(b, f"critic gate {gate}; wave {sum(results_wave)}/2")
    boulder.save(slug, b)
    score = score_mod.compute(b, gate)["score"]
    rp = rep.write(os.path.expanduser("~/.fleet/out"), slug, f"research: {topic}",
                   assignments, b, score,
                   f"fan-out {ok_n}/{len(prompts)} explorers; critic gate: {gate}")
    print(f"tony: report {rp} (brief: {report_path})")
    print(f"RESEARCH SCORE: {score}/100")
    return 0


def cmd_mission(mission: str, parallel: bool = False, max_verify: int = 3,
                keep_going: bool = False, timeout: int = 600, yes: bool = False) -> int:
    """One-shot: architect plan -> boulder -> execute -> critic -> wave -> report."""
    from lib import engine as eng
    from lib import plangate as gate_mod
    from lib import report as rep
    from lib import packs as packs_mod
    # P18: direct missions can carry @pack refs too — the architect sees the
    # full payload, schedule.json-style pointers never reach the model.
    if packs_mod.has_pack_ref(mission):
        expanded = packs_mod.expand(mission)
        if expanded.strip():
            mission = expanded
    models = catalog.live_catalog()
    overrides = config.get_roles() or None
    raw = tiers.assign_roles_with_sources(models, overrides)
    assignments = {r: (v["model"] if isinstance(v, dict) else v) for r, v in raw.items()}
    slug = slugify(mission)
    workdir = os.path.join(os.path.expanduser("~"), ".tony", "work", slug)
    print(f"tony: mission '{mission[:80]}' -> slug {slug}")
    print(f"tony: architect = {assignments['architect']}")
    arch = eng.role_call("architect", assignments["architect"],
                         roles.architect_prompt(mission, mcp.names(),
                                                mem_mod.recall(limit=20),
                                                matched_skills=_matched_skills(mission)), workdir,
                         timeout=timeout)
    print(f"tony: architect call {arch['status']} ({arch['duration']:.0f}s) -> {arch['outfile']}")
    if arch["status"] != "ok":
        print("tony: architect failed; boulder unwritten")
        return 1
    clean = eng.sanitize(arch["output"])
    b = boulder.parse(clean) if "# Boulder" in clean else boulder.new(slug)
    if not b["todos"]:
        boulder.add_todo(b, clean[:400])
    boulder.log(b, f"mission started: {mission[:120]}")
    import sys as _sys
    if not gate_mod.confirm_plan(b, is_tty=_sys.stdin.isatty(), pre_approved=yes):
        p = boulder.save(slug, b)
        print(f"tony: boulder {p} — plan held, zero builder calls spent")
        print("MISSION HELD — plan declined at gate")
        return 2
    tier_models = {r: tiers.pick(models, t) for r, (t, _e) in tiers.ROLES.items()}
    eng.run_loop(b, tier_models, workdir, parallel=parallel,
                 sleep_fn=time.sleep, timeout=timeout)

    def _builder_fix(fails):
        fix = eng.role_call("builder", assignments["builder"],
                            "Fix these failing verification steps, then stop:\n" +
                            "\n".join(fails), workdir, timeout=timeout)
        boulder.log(b, f"builder fix: {fix['status']}")

    gate = "N/A"
    evidence = None
    fix_status = "none"
    # P19c: critic runs at >=2 TODOs (was >=3 — small missions got a free pass).
    if len(b["todos"]) >= 2:
        crit_prompt = roles.critic_prompt(boulder.render(b))
        crit = eng.role_call("critic", assignments["critic"], crit_prompt, workdir,
                             timeout=timeout)
        boulder.log(b, f"critic ({assignments['critic']}): {crit['output'][:300]}")
        gate_detail, _strong = eng.critic_gate_detail(crit["output"])
        evidence = eng.evidence_coverage(crit["output"], b["todos"])
        gate, fix_status = eng.apply_critic_gate(b, gate_detail, keep_going,
                                                 fix_fn=_builder_fix,
                                                 critic_output=crit["output"])

    if fix_status == "fail":
        # P22: the P21 live-fire finding — ISSUES + failed fix, wave still runs
        # under --yes/headless. Print the override where a human will see it,
        # not just in the boulder log.
        print("tony: critic gate ISSUES OVERRIDE — builder fix failed; "
              "wave results are UNVERIFIED-until-they-pass")

    eng.verify_wave(b, max_verify=max_verify, cwd=workdir, fix_fn=_builder_fix) if eng.should_run_wave(b, keep_going) else boulder.log(b, "wave skipped (BLOCKED TODOs; use --keep-going to run anyway)")
    p = boulder.save(slug, b)
    score = cmd_score(b, gate, evidence)
    rp = rep.write(os.path.expanduser("~/.fleet/out"), slug, mission,
                   assignments, b, score, f"auto-scored by wave+todo completion; critic gate: {gate}")
    print(f"tony: boulder {p} — {sum(1 for t in b['todos'] if t['box'])}/{len(b['todos'])} TODOs, {sum(1 for w in b['wave'] if w['box'])}/{len(b['wave'])} wave")
    print(f"tony: report {rp}")
    print(f"MISSION SCORE: {score}/100 — auto-scored by wave+todo completion")
    return 0


def cmd_resume(slug: str, parallel: bool = False, max_verify: int = 3,
               keep_going: bool = False, timeout: int = 600) -> int:
    """Resume: load ~/.tony/boulders/<slug>.md, run unchecked TODOs + wave + report.

    No second architect call — continuity lives in the boulder (scripture Ch.2
    crash-safe rule). Critic is not re-run; the wave is the gate."""
    from lib import engine as eng
    from lib import report as rep
    p = boulder.path_for(slug)
    try:
        b = boulder.load(p)
    except OSError:
        print(f"tony: no boulder '{slug}' ({p})")
        return 2
    if not b["todos"] and not b["wave"]:
        print(f"tony: boulder '{slug}' is empty, nothing to resume")
        return 2
    models = catalog.live_catalog()
    overrides = config.get_roles() or None
    raw = tiers.assign_roles_with_sources(models, overrides)
    assignments = {r: (v["model"] if isinstance(v, dict) else v) for r, v in raw.items()}
    workdir = os.path.join(os.path.expanduser("~"), ".tony", "work", slug)
    boulder.log(b, f"resume: {sum(1 for t in b['todos'] if t['box'])}/{len(b['todos'])} TODOs already done")
    tier_models = {r: tiers.pick(models, t) for r, (t, _e) in tiers.ROLES.items()}

    def _builder_fix(fails):
        fix = eng.role_call("builder", assignments["builder"],
                            "Fix these failing verification steps, then stop:\n" +
                            "\n".join(fails), workdir, timeout=timeout)
        boulder.log(b, f"builder fix: {fix['status']}")

    eng.run_loop(b, tier_models, workdir, parallel=parallel,
                 sleep_fn=time.sleep, timeout=timeout)
    if eng.should_run_wave(b, keep_going):
        eng.verify_wave(b, max_verify=max_verify, cwd=workdir, fix_fn=_builder_fix)
    else:
        boulder.log(b, "wave skipped (BLOCKED TODOs; use --keep-going to run anyway)")
    p = boulder.save(slug, b)
    score = cmd_score(b, "N/A")
    rp = rep.write(os.path.expanduser("~/.fleet/out"), slug, f"resume: {b['title']}",
                   assignments, b, score, "resume: auto-scored by wave+todo completion")
    print(f"tony: resumed {p} — {sum(1 for t in b['todos'] if t['box'])}/{len(b['todos'])} TODOs, {sum(1 for w in b['wave'] if w['box'])}/{len(b['wave'])} wave")
    print(f"tony: report {rp}")
    print(f"MISSION SCORE: {score}/100 — resume: auto-scored by wave+todo completion")
    return 0


def cmd_watch(slug: str, interval: int = 2, once: bool = False, timeout: int = 0) -> int:
    """Watch: poll a boulder's progress via render_snapshot + runs.log + workdir."""
    bpath = boulder.path_for(slug)
    try:
        b = boulder.load(bpath)
    except OSError:
        print(f"tony: no boulder '{slug}' ({bpath})")
        return 2

    runslog = os.path.join(TONY_DIR, "runs.log")
    workdir = os.path.join(TONY_DIR, "work", slug)

    def _snapshot() -> str:
        try:
            b2 = boulder.load(bpath)
        except OSError:
            b2 = b
        runs_tail = watch.tail_lines(runslog, 15)
        wf = watch.work_files(workdir)
        return watch.render_snapshot(b2, runs_tail, wf, None)

    def _done(bd: dict) -> bool:
        p = boulder.progress(bd)
        return p["done"] == p["total"] and p["waved"] == p["wavetotal"]

    if once:
        if not os.path.exists(bpath):
            print(f"tony: no boulder '{slug}' ({bpath})")
            return 2
        snapshot = _snapshot()
        print(snapshot, end="")
        if _done(b):
            p = boulder.progress(b)
            print(f"SCORE: {p['score']}/100")
            return 0
        return 1

    # Poll loop
    t0 = time.time()
    try:
        while True:
            print("\033[2J\033[H", end="")
            try:
                b = boulder.load(bpath)
            except OSError:
                print(f"tony: no boulder '{slug}' ({bpath})")
                return 2
            snapshot = _snapshot()
            print(snapshot, end="")
            if _done(b):
                p = boulder.progress(b)
                print(f"SCORE: {p['score']}/100")
                return 0
            if timeout > 0 and (time.time() - t0) >= timeout:
                p = boulder.progress(b)
                print(f"SCORE: {p['score']}/100")
                return 0
            time.sleep(interval)
    except KeyboardInterrupt:
        return 130



def cmd_add_schedule(spec: str) -> int:
    """--add-schedule "NAME :: CRON :: MISSION" (or "CRON :: MISSION",
    name slugified from the mission). Validates the cron before writing."""
    from lib import sched as sched_mod
    parts = [p.strip() for p in spec.split("::")]
    if len(parts) == 3:
        name, cron, mission = parts
    elif len(parts) == 2:
        cron, mission = parts
        name = slugify(mission)
    else:
        print("tony: --add-schedule needs 'NAME :: CRON :: MISSION' "
              "or 'CRON :: MISSION'", file=sys.stderr)
        return 2
    try:
        job = sched_mod.add(None, name, cron, mission)
    except ValueError as e:
        print(f"tony: --add-schedule: {e}", file=sys.stderr)
        return 2
    try:
        import datetime as _dt
        nxt = sched_mod.next_run(job["cron"], _dt.datetime.now())
        nxt_s = nxt.strftime("%Y-%m-%d %H:%M")
    except ValueError:
        nxt_s = "never (impossible cron)"
    print(f"tony: scheduled '{job['name']}' ({job['cron']}) -> next {nxt_s}")
    return 0


def cmd_list_schedule(_args) -> int:
    from lib import sched as sched_mod
    jobs = sched_mod.load(None)
    if not jobs:
        print("tony: no schedules (~/.tony/schedule.json)")
        return 0
    for j in jobs:
        print(f"{j.get('name')}  [{j.get('cron')}]  {j.get('mission', '')[:80]}")
    return 0


def cmd_rm_schedule(name: str) -> int:
    from lib import sched as sched_mod
    if sched_mod.remove(None, name):
        print(f"tony: schedule '{name}' removed")
        return 0
    print(f"tony: no schedule '{name}'", file=sys.stderr)
    return 2


def cmd_daemon(inbox: str | None, interval: int = 10, once: bool = False,
               parallel: bool = False, max_verify: int = 3,
               keep_going: bool = False, timeout: int = 600) -> int:
    """Resident inbox loop: ~/.tony/inbox/*.md -> cmd_mission -> inbox-done/."""
    from lib import daemon as daemon_mod
    box = inbox or daemon_mod.inbox_dir()
    os.makedirs(box, exist_ok=True)

    def _mission(text: str, stem: str) -> str:
        rc = cmd_mission((text or "").strip() or stem, parallel=parallel,
                         max_verify=max_verify, keep_going=keep_going,
                         timeout=timeout, yes=True)
        return f"cmd_mission exit={rc} (see boulder/report for {stem})"

    if once:
        res = daemon_mod.run_once(box, _mission)
        if res is None:
            print(f"tony: inbox empty ({box})")
            return 0
        print(f"tony: daemon-once {res['name']} -> {res['status']} ({res['report_path']})")
        return 0
    print(f"tony: daemon listening on {box} (Ctrl-C to stop)")
    n = daemon_mod.loop(box, _mission, interval=interval)
    print(f"tony: daemon stopped after {n} job(s)")
    return 0


def cmd_packs(name: str | None = None) -> int:
    """--packs lists ~/.tony/packs/*.md; --pack NAME prints one body."""
    from lib import packs as packs_mod
    if name:
        body = packs_mod.read_pack(name)
        if not body:
            print(f"tony: no readable pack '{name}' (~/.tony/packs/{name}.md)",
                  file=sys.stderr)
            return 2
        print(body)
        return 0
    found = packs_mod.list_packs()
    if not found:
        print("no packs in ~/.tony/packs (drop *.md files there; "
              "reference with @pack:<name>)")
        return 0
    for n in found:
        body = packs_mod.read_pack(n)
        print(f"{n}  ({len(body)} chars)")
    return 0


def cmd_install_defaults() -> int:
    """--install-defaults: seed builtin packs + Hermes-gap cron jobs (idempotent)."""
    import datetime as _dt
    from lib import packs as packs_mod
    res = packs_mod.ensure_defaults(None)
    if res["packs"]:
        print("tony: packs seeded: " + ", ".join(res["packs"]))
    if res["jobs"]:
        print("tony: schedules added: " + ", ".join(res["jobs"]))
    if not res["packs"] and not res["jobs"]:
        print("tony: defaults already installed (existing packs/jobs untouched)")
    from lib import sched as sched_mod
    for j in sched_mod.load(None):
        if j.get("name") in ("morning-briefing", "memory-hygiene"):
            try:
                nxt = sched_mod.next_run(j["cron"], _dt.datetime.now())
                when = nxt.strftime("%Y-%m-%d %H:%M")
            except ValueError:
                when = "never (impossible cron)"
            print(f"tony: {j['name']} [{j['cron']}] -> next {when}")
    return 0


def selftest_checks() -> list[tuple[str, bool, str]]:
    """Run stock self-verification checks. Returns [(name, ok, detail)].

    tests: run_tests.py full suite. waveguard: hostile-command seam.
    ruff/mypy: optional tools — SKIP when missing, never a fake PASS.
    """
    import subprocess
    results: list[tuple[str, bool, str]] = []

    r = subprocess.run([sys.executable, os.path.join(TONY_DIR_ROOT, "run_tests.py"),
                        "--skip-self"],
                       capture_output=True, text=True, cwd=TONY_DIR_ROOT, timeout=300)
    line = (r.stdout or "").strip().splitlines()[-1] if (r.stdout or "").strip() else ""
    ok = r.returncode == 0 and "FAIL=0" in line
    results.append(("tests", ok, line or f"exit={r.returncode}"))

    try:
        from lib import boulder, engine
        b = boulder.new("selftest-waveguard")
        boulder.add_wave(b, "F1. sudo rm -rf /tmp/tony-selftest-never")
        # P24: cwd=/tmp intentional — synthetic boulder, no mission workdir exists.
        res = engine.run_wave(b, cwd="/tmp")
        ok = res == [False] and any("BLOCKED by waveguard" in ln for ln in b["log"])
        results.append(("waveguard", bool(ok), "hostile wave blocked" if ok else "NOT blocked"))
    except Exception as e:
        results.append(("waveguard", False, f"exception: {type(e).__name__}"))

    for name, cmd in (("ruff", ["ruff", "check", "."]), ("mypy", ["mypy", "tony", "lib"])):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, cwd=TONY_DIR_ROOT, timeout=300)
        except FileNotFoundError:
            results.append((name, True, "SKIP (tool absent)"))
            continue
        tail = (r.stdout or r.stderr or "").strip().splitlines()[-1:]
        detail = tail[0] if tail else f"exit={r.returncode}"
        results.append((name, r.returncode == 0, detail))
    return results


def selftest_exit(results: list) -> int:
    """Print one line per check; exit 0 only when nothing failed."""
    bad = 0
    for name, ok, detail in results:
        status = "PASS" if ok else "FAIL"
        if not ok:
            bad += 1
        print(f"SELFTEST {status} {name}: {detail}")
    print(f"SELFTEST {'PASS' if bad == 0 else 'FAIL'} ({len(results) - bad}/{len(results)} checks)")
    return 0 if bad == 0 else 1


def cmd_selftest() -> list:
    """--selftest: verify suite + waveguard + lint/types. Returns check list."""
    return selftest_checks()


def main(argv=None) -> int:
    argv = argv or sys.argv[1:]
    p = argparse.ArgumentParser(prog="tony", description="free-model-native agent CLI")
    p.add_argument("--version", action="store_true")
    p.add_argument("--models", action="store_true", help="print live catalog + role assignments")
    p.add_argument("--status", action="store_true", help="JSON: catalog + tiers + roles + mcp + boulders")
    p.add_argument("--mcp-status", action="store_true", help="list MCP servers delegates inherit via opencode")
    p.add_argument("--skills", action="store_true", help="list discovered skills from ~/.tony/skills")
    p.add_argument("--packs", action="store_true", help="list domain packs from ~/.tony/packs")
    p.add_argument("--pack", metavar="NAME", default=None, help="print one domain pack body (referenced in missions as @pack:NAME)")
    p.add_argument("--install-defaults", action="store_true", help="seed builtin packs + morning-brief/memory-hygiene schedules (idempotent)")
    p.add_argument("--selftest", action="store_true", help="self-verify: run stock suite + waveguard seam + ruff/mypy, print one PASS/FAIL line each")
    p.add_argument("--doctor", action="store_true", help="self-diagnose: binary, catalog, roles, config, daemon, schedules, paths, MCP; exit 1 on any fail")
    p.add_argument("--research", metavar="TOPIC", default=None, help="deep-research fan-out: 3 parallel explorers (websearch MCP) -> cited synthesis -> critic gate")
    p.add_argument("--install-daemon", action="store_true", help="write + enable the systemd user unit (tony --daemon at login, no sudo)")
    p.add_argument("--remember", metavar="FACT", default=None, help="append one dated fact to ~/.tony/memory/MEMORY.md")
    p.add_argument("--recall", metavar="QUERY", nargs="?", const="", default=None, help="print memory lines matching QUERY (or all when bare)")
    p.add_argument("--forget", metavar="SUBSTR", default=None, help="remove memory lines containing SUBSTR")
    p.add_argument("--memory", action="store_true", help="print memory file path + full dump")
    p.add_argument("--chat", metavar="SESSION", nargs="?", const="default", default=None, help="conversational loop with history (default session when bare)")
    p.add_argument("--dry-run", metavar="MISSION", default=None, help="plan only, write boulder, execute nothing")
    p.add_argument("--parallel", action="store_true", help="run [role:explorer] TODOs concurrently via threads")
    p.add_argument("--max-verify", metavar="N", type=int, default=3, help="total wave attempts (default 3); fixes run between attempts only")
    p.add_argument("--resume", metavar="SLUG", default=None, help="resume boulder <slug>: run unchecked TODOs + wave, no second architect call")
    p.add_argument("--keep-going", action="store_true", help="run the wave even with [BLOCKED] TODOs (default: wave skipped when blocked)")
    p.add_argument("--yes", action="store_true", help="skip the pre-execution plan gate (default: TTY missions pause for y/N)")
    p.add_argument("--watch", metavar="SLUG", default=None, help="poll <slug> boulder progress")
    p.add_argument("--tui", metavar="SLUG", default=None, help="curses TUI for <slug> (falls back to poll loop when no TTY)")
    p.add_argument("--daemon", action="store_true", help="resident inbox loop on ~/.tony/inbox (Ctrl-C to stop)")
    p.add_argument("--daemon-once", action="store_true", help="run a single inbox mission then exit")
    p.add_argument("--inbox", metavar="PATH", default=None, help="inbox dir for --daemon (default ~/.tony/inbox)")
    p.add_argument("--add-schedule", metavar="SPEC", default=None, help="add cron schedule: 'NAME :: CRON :: MISSION' (or 'CRON :: MISSION')")
    p.add_argument("--list-schedule", action="store_true", help="list cron schedules from ~/.tony/schedule.json")
    p.add_argument("--rm-schedule", metavar="NAME", default=None, help="remove cron schedule by name")
    p.add_argument("--interval", metavar="N", type=int, default=10, help="daemon poll interval in seconds (default 10)")
    p.add_argument("--timeout", metavar="N", type=int, default=600, help="mission timeout in seconds (default 600); per-role budgets scale from it (architect 1.0, builder 0.8, researcher/critic 0.6, explorer 0.4, scribe 0.2)")
    p.add_argument("--fast", action="store_true", help="halve all role timeouts (mission timeout / 2): cheap missions, tighter stall caps")
    p.add_argument("--set-role", metavar="ROLE=PATTERN", default=None, help="pin role to a live-model regex pattern")
    p.add_argument("--clear-role", metavar="ROLE", default=None, help="drop a role override")
    p.add_argument("--show-config", action="store_true", help="print effective role->model map with sources")
    p.add_argument("--auto-config", action="store_true", help="clear overrides, reseat from live catalog")
    p.add_argument("mission", nargs="?", default=None, help="one-shot mission text")
    args, _ = p.parse_known_args(argv)
    if getattr(args, "fast", False):
        from lib import engine as _eng
        args.timeout = _eng.effective_timeout(args.timeout, True)
    if args.version:
        print(f"tony {VERSION}")
        return 0
    if args.watch:
        watch_idx = argv.index("--watch")
        rest = argv[watch_idx + 1:]
        wp = argparse.ArgumentParser(prog="tony watch")
        wp.add_argument("slug", help="boulder slug to watch")
        wp.add_argument("--interval", type=int, default=2, help="poll interval in seconds (default 2)")
        wp.add_argument("--once", action="store_true", help="print a single snapshot and exit")
        wp.add_argument("--timeout", type=int, default=0, help="exit after S seconds (0=never)")
        wargs = wp.parse_args(rest)
        return cmd_watch(wargs.slug, interval=wargs.interval, once=wargs.once, timeout=wargs.timeout)
    if args.mission == "watch" and "watch" in argv and argv.index("watch") + 1 < len(argv):
        wi = argv.index("watch")
        wp = argparse.ArgumentParser(prog="tony watch")
        wp.add_argument("slug", help="boulder slug to watch")
        wp.add_argument("--interval", type=int, default=2, help="poll interval in seconds (default 2)")
        wp.add_argument("--once", action="store_true", help="print a single snapshot and exit")
        wp.add_argument("--timeout", type=int, default=0, help="exit after S seconds (0=never)")
        wargs = wp.parse_args(argv[wi + 1:])
        return cmd_watch(wargs.slug, interval=wargs.interval, once=wargs.once, timeout=wargs.timeout)
    if args.tui:
        from lib import tui as tui_mod
        tui_idx = argv.index("--tui")
        tui_slug = argv[tui_idx + 1] if tui_idx + 1 < len(argv) else None
        if not tui_slug:
            print("tony: --tui requires a slug", file=sys.stderr)
            return 2
        if tui_mod.should_use_curses():
            return tui_mod.run_tui(tui_slug)
        else:
            print(f"tony: --tui: no TTY available; falling back to poll loop for '{tui_slug}'")
            return cmd_watch(tui_slug)
    if args.set_role:
        return cmd_set_role(args.set_role)
    if args.clear_role:
        return cmd_clear_role(args.clear_role)
    if args.show_config:
        return cmd_show_config(args)
    if args.auto_config:
        return cmd_auto_config(args)
    if args.resume:
        return cmd_resume(args.resume, parallel=args.parallel, max_verify=args.max_verify,
                          keep_going=args.keep_going, timeout=args.timeout)
    if args.daemon or args.daemon_once:
        return cmd_daemon(args.inbox, interval=args.interval, once=args.daemon_once,
                          parallel=args.parallel, max_verify=args.max_verify,
                          keep_going=args.keep_going, timeout=args.timeout)
    if args.add_schedule:
        return cmd_add_schedule(args.add_schedule)
    if args.list_schedule:
        return cmd_list_schedule(args)
    if args.rm_schedule:
        return cmd_rm_schedule(args.rm_schedule)
    if args.install_daemon:
        from lib import packaging
        res = packaging.install()
        print(f"tony: unit {res['unit_path']}")
        if res["enabled"]:
            print("tony: daemon enabled + started (systemctl --user)")
            return 0
        print(f"tony: enable FAILED: {res.get('error', 'unknown')}")
        return 1
    if args.research:
        return cmd_research(args.research, timeout=args.timeout)
    if args.skills:
        from lib import skills as skills_mod
        found = skills_mod.discover()
        if not found:
            print("no skills in ~/.tony/skills (drop *.md files there)")
        for s in found:
            print(f"{s['name']}  ({s['path']})")
        return 0
    if args.install_defaults:
        return cmd_install_defaults()
    if args.selftest:
        return selftest_exit(cmd_selftest())
    if args.doctor:
        return cmd_doctor()
    if args.packs or args.pack:
        return cmd_packs(args.pack)
    if args.mcp_status:
        return cmd_mcp_status(args)
    if args.remember:
        return cmd_remember(args.remember)
    if args.recall is not None:
        return cmd_recall(args.recall or None)
    if args.forget:
        return cmd_forget(args.forget)
    if args.memory:
        return cmd_memory(args)
    if args.chat is not None:
        return cmd_chat(args.chat or "default", timeout=args.timeout)
    if args.status:
        return cmd_status(args)
    if args.dry_run:
        return cmd_dryrun(args.dry_run)
    if args.mission:
        return cmd_mission(args.mission, parallel=args.parallel, max_verify=args.max_verify,
                           keep_going=args.keep_going, timeout=args.timeout, yes=args.yes)
    return cmd_models(args)


if __name__ == "__main__":
    sys.exit(main())
